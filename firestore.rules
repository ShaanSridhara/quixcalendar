rules_version = '2';

// Quix Calendar — Comprehensive Hardened Security Rules
// -----------------------------------------------------------------------------
// Security Goals:
//  1. C1 & M3: Membership isolation — Store and check membership on calendar docs (`calData.members` / `calData.roles` / `calData.uid`).
//     Prevent unauthorized collection dumping of users, calendars, or events.
//  2. H2: Prevent cross-user account tampering or role self-promotion.
//  3. H3 & M1: Strict event ownership and calendar membership validation on creation and update.
//  4. M2: Rules-level format validation for colors, times, titles, and avatar URLs.
// -----------------------------------------------------------------------------

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──────────────────────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    // Platform Super Admin (Charlie)
    function isPlatformAdmin() {
      return isSignedIn()
        && request.auth.uid == 'FFCcwj3440ZXFcDZVAZzXmGuRQw2';
    }

    // ── Field-format validation (M2) ─────────────────────────────────────────
    function validHexColor(v) {
      return v == null || v.matches('^#[0-9a-fA-F]{6}$');
    }
    function validTime(v) {
      return v == null || v.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$');
    }
    function validPfpUrl(v) {
      return v == null || v.matches('^data:image/(png|jpe?g|webp|gif);base64,.*');
    }
    function validPriority(v) {
      return v == null || v in ['critical', 'important', 'optional', 'high', 'medium', 'low'];
    }
    function validateEventFields(d) {
      return validHexColor(d.get('color', null))
        && validTime(d.get('time', null))
        && validTime(d.get('timeEnd', null))
        && validPriority(d.get('priority', null));
    }

    function isCalendarMember(calData) {
      return isSignedIn() && (
        calData.uid == request.auth.uid
        || request.auth.uid in calData.get('roles', {})
        || request.auth.uid in calData.get('members', [])
      );
    }

    function isMemberOfCalendarId(calId) {
      return calId is string && calId != '' && (
        exists(/databases/$(database)/documents/calendars/$(calId))
        && isCalendarMember(get(/databases/$(database)/documents/calendars/$(calId)).data)
      );
    }

    function leadsCalendarId(calId) {
      return calId is string && calId != '' && (
        exists(/databases/$(database)/documents/calendars/$(calId))
        && (
          get(/databases/$(database)/documents/calendars/$(calId)).data.uid == request.auth.uid
          || request.auth.uid in get(/databases/$(database)/documents/calendars/$(calId)).data.get('roles', {})
        )
      );
    }

    // ── Users ────────────────────────────────────────────────────────────────
    match /users/{userId} {
      // Single profile fetch
      allow get: if isSignedIn();

      // Querying users: only self or platform admin (no bulk scans)
      allow list: if isSignedIn() && (
        request.auth.uid == userId
        || isPlatformAdmin()
      );

      // Creation: must be for self, cannot set Admin role
      allow create: if isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.get('role', null) != 'Admin'
        && validPfpUrl(request.resource.data.get('pfpUrl', null));

      // Updates: self profile updates only (cannot change role), or platform admin
      allow update: if isSignedIn() && (
        isPlatformAdmin()
        || (
          validPfpUrl(request.resource.data.get('pfpUrl', null))
          && request.auth.uid == userId
          && request.resource.data.get('role', null) == resource.data.get('role', null)
        )
      );

      allow delete: if request.auth.uid == userId || isPlatformAdmin();
    }

    // ── Calendars ────────────────────────────────────────────────────────────
    match /calendars/{calId} {
      // Direct doc fetch: must be owner, member, or platform admin
      allow get: if isSignedIn() && (
        isCalendarMember(resource.data)
        || isPlatformAdmin()
      );

      // List query: owner, member, platform admin, or looking up invite code with limit <= 5
      allow list: if isSignedIn() && (
        resource.data.uid == request.auth.uid
        || request.auth.uid in resource.data.get('roles', {})
        || request.auth.uid in resource.data.get('members', [])
        || isPlatformAdmin()
        || (resource.data.inviteCode != null && request.query.limit != null && request.query.limit <= 5)
      );

      // Creation: must stamp self as creator/owner
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid;

      // Updates:
      // 1. Owner or role-holder (cannot change owner `uid`)
      // 2. User joining via invite code (only adding self to `members` array)
      allow update: if isSignedIn() && (
        isPlatformAdmin()
        || (
          (resource.data.uid == request.auth.uid || request.auth.uid in resource.data.get('roles', {}))
          && request.resource.data.uid == resource.data.uid
        )
        || (
          // Join via invite code: the update must prove knowledge of the code.
          resource.data.inviteCode != null
          && request.resource.data.get('joinCode', '') == resource.data.inviteCode
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'joinCode'])
          && request.resource.data.members.hasAll(resource.data.get('members', []))
          && request.auth.uid in request.resource.data.members
          && request.resource.data.uid == resource.data.uid
        )
        || (
          // Leave: a member may remove ONLY themselves from `members`
          request.auth.uid in resource.data.get('members', [])
          && !(request.auth.uid in request.resource.data.get('members', []))
          && request.resource.data.get('members', []).size() == resource.data.get('members', []).size() - 1
          && request.resource.data.get('members', []).hasOnly(resource.data.get('members', []))
          && request.resource.data.uid == resource.data.uid
        )
      );

      // Deletion: owner or platform admin only
      allow delete: if isSignedIn() && (
        resource.data.uid == request.auth.uid || isPlatformAdmin()
      );
    }

    // ── Events ───────────────────────────────────────────────────────────────
    match /events/{eventId} {
      allow get, list: if isSignedIn() && (
        resource.data.uid == request.auth.uid
        || request.auth.uid in resource.data.get('inviteeUids', [])
        || request.auth.uid in resource.data.get('assigneeUids', [])
        || isMemberOfCalendarId(resource.data.get('calendarId', ''))
        || isMemberOfCalendarId(resource.data.get('sharedCalId', ''))
        || isPlatformAdmin()
      );

      // Creation: must be creator AND a member of the target calendar
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && validateEventFields(request.resource.data)
        && (
          request.resource.data.get('calendarId', '') == ''
          || isMemberOfCalendarId(request.resource.data.get('calendarId', ''))
          || isPlatformAdmin()
        );

      // Updates: owner/leaders full control (uid+calendarId immutable);
      // invitees/assignees/plain members may only change their own RSVP/opt-out/decline,
      // task-completion and outreach-report fields
      allow update: if isSignedIn() && validateEventFields(request.resource.data) && (
        isPlatformAdmin()
        || (
          (
            resource.data.uid == request.auth.uid
            || leadsCalendarId(resource.data.get('calendarId', ''))
            || leadsCalendarId(resource.data.get('sharedCalId', ''))
          )
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.calendarId == resource.data.calendarId
        )
        || (
          (
            request.auth.uid in resource.data.get('inviteeUids', [])
            || request.auth.uid in resource.data.get('assigneeUids', [])
            || isMemberOfCalendarId(resource.data.get('calendarId', ''))
            || isMemberOfCalendarId(resource.data.get('sharedCalId', ''))
          )
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.calendarId == resource.data.calendarId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'rsvp', 'rsvpByDate',
            'optionalOptOut', 'optionalOptOutByDate',
            'declineReasons', 'declineReasonsByDate',
            'completed', 'completedBy', 'completedAt',
            'outreachImpactCount', 'outreachCountUpdatedBy', 'outreachCountUpdatedAt',
            'outreachHours', 'outreachHoursByDate'
          ])
          && request.resource.data.get('rsvp', {}).diff(resource.data.get('rsvp', {})).affectedKeys().hasOnly([request.auth.uid])
          && request.resource.data.get('optionalOptOut', {}).diff(resource.data.get('optionalOptOut', {})).affectedKeys().hasOnly([request.auth.uid])
          && request.resource.data.get('declineReasons', {}).diff(resource.data.get('declineReasons', {})).affectedKeys().hasOnly([request.auth.uid])
        )
      );

      // Deletion: event creator, calendar leader, or platform admin
      allow delete: if isSignedIn() && (
        resource.data.uid == request.auth.uid
        || leadsCalendarId(resource.data.get('calendarId', ''))
        || isPlatformAdmin()
      );
    }

    // ── Bug Reports ──────────────────────────────────────────────────────────
    match /bugReports/{reportId} {
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid;
      allow read, update, delete: if isPlatformAdmin();
    }

    // ── Social (social media stats) ─────────────────────────────────────────
    // Stats docs (summary, etc.) are written only by the social-scraper's
    // Admin SDK connection, which bypasses these rules entirely — clients
    // only ever read. `config` is the one exception: platform admins can
    // edit it directly (e.g. adding a TikTok video URL to track), and
    // social-scraper reads it alongside social-scraper/config.json on each
    // run.
    match /social/config {
      allow read: if isSignedIn();
      allow write: if isPlatformAdmin();
    }
    match /social/{docId} {
      allow read: if isSignedIn();
      allow create, update, delete: if false;
    }
    // One doc per day (growth-over-time snapshots for the Social page's
    // charts) — same lockdown as social/summary, written only by the
    // scraper's Admin SDK connection.
    match /socialHistory/{docId} {
      allow read: if isSignedIn();
      allow create, update, delete: if false;
    }

    // ── Default Deny ─────────────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
