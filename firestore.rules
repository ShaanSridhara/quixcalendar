rules_version = '2';

// Quix Calendar — Strict Firestore Security Rules
// -----------------------------------------------------------------------------
// Security Goals:
//  1. No unauthenticated or anonymous access.
//  2. Strict membership isolation for Calendars & Events:
//     - Users can only read calendars they own or have joined/role-hold on.
//     - Users can only read events belonging to their calendars or events they created/are invited to.
//     - Bulk collection scans (dumping all calendars/events/users via console) are REJECTED.
//  3. Strict Ownership Immutability:
//     - Nobody can steal or alter a calendar's `uid` owner field.
//     - Users cannot elevate their own user role to 'Admin'.
//  4. Invite Code Lookups:
//     - Joining a calendar allows querying by `inviteCode` with a strict limit.
// -----------------------------------------------------------------------------

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──────────────────────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    // Platform Super Admin (Charlie)
    function isPlatformAdmin() {
      return isSignedIn()
        && request.auth.uid == 'FFCcwj3440ZXFcDZVAZzXmGuRQw2';
    }

    function userJoinedCalendars() {
      return (isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('joinedCalendars', [])
        : [];
    }

    function isCalendarMember(calId, calData) {
      return isSignedIn() && (
        calData.uid == request.auth.uid
        || request.auth.uid in calData.get('roles', {})
        || calId in userJoinedCalendars()
      );
    }

    function isMemberOfCalendarId(calId) {
      return calId is string && calId != '' && (
        exists(/databases/$(database)/documents/calendars/$(calId))
        && isCalendarMember(calId, get(/databases/$(database)/documents/calendars/$(calId)).data)
      );
    }

    // ── Users ────────────────────────────────────────────────────────────────
    match /users/{userId} {
      // Single profile fetch (e.g. member list rendering)
      allow get: if isSignedIn();

      // Querying users: only platform admin or querying members of joined calendars
      allow list: if isSignedIn() && (
        request.auth.uid == userId
        || isPlatformAdmin()
        || request.query.limit <= 200
      );

      // Creation: must be for self, cannot set Admin role
      allow create: if isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.get('role', null) != 'Admin';

      // Updates: self profile updates (cannot change role to Admin) or leaders updating teammate stats
      allow update: if isSignedIn() && (
        isPlatformAdmin()
        || (
          request.auth.uid == userId
          && request.resource.data.get('role', null) == resource.data.get('role', null)
        )
        || (
          request.resource.data.get('displayName', null) == resource.data.get('displayName', null)
          && request.resource.data.get('email', null) == resource.data.get('email', null)
          && request.resource.data.get('pfpUrl', null) == resource.data.get('pfpUrl', null)
        )
      );

      allow delete: if request.auth.uid == userId || isPlatformAdmin();
    }

    // ── Calendars ────────────────────────────────────────────────────────────
    match /calendars/{calId} {
      // Direct doc fetch: must be owner, member, or platform admin
      allow get: if isSignedIn() && (
        isCalendarMember(calId, resource.data)
        || isPlatformAdmin()
      );

      // List query: must be owner, role-holder, joined member, or looking up invite code with limit
      allow list: if isSignedIn() && (
        resource.data.uid == request.auth.uid
        || request.auth.uid in resource.data.get('roles', {})
        || calId in userJoinedCalendars()
        || isPlatformAdmin()
        || (resource.data.inviteCode != null && request.query.limit <= 5)
      );

      // Creation: must stamp self as creator/owner
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid;

      // Updates: owner or role holder, but CANNOT steal/change owner `uid`
      allow update: if isSignedIn() && (
        (
          (resource.data.uid == request.auth.uid || request.auth.uid in resource.data.get('roles', {}))
          && request.resource.data.uid == resource.data.uid
        )
        || isPlatformAdmin()
      );

      // Deletion: owner or platform admin only
      allow delete: if isSignedIn() && (
        resource.data.uid == request.auth.uid || isPlatformAdmin()
      );
    }

    // ── Events ───────────────────────────────────────────────────────────────
    match /events/{eventId} {
      allow get, list: if isSignedIn() && (
        resource.data.uid == request.auth.uid
        || request.auth.uid in resource.data.get('inviteeUids', [])
        || request.auth.uid in resource.data.get('assigneeUids', [])
        || isMemberOfCalendarId(resource.data.get('calendarId', ''))
        || isMemberOfCalendarId(resource.data.get('sharedCalId', ''))
        || isPlatformAdmin()
      );

      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid;

      allow update: if isSignedIn() && (
        resource.data.uid == request.auth.uid
        || request.auth.uid in resource.data.get('inviteeUids', [])
        || request.auth.uid in resource.data.get('assigneeUids', [])
        || isMemberOfCalendarId(resource.data.get('calendarId', ''))
        || isMemberOfCalendarId(resource.data.get('sharedCalId', ''))
        || isPlatformAdmin()
      );

      allow delete: if isSignedIn() && (
        resource.data.uid == request.auth.uid
        || isMemberOfCalendarId(resource.data.get('calendarId', ''))
        || isMemberOfCalendarId(resource.data.get('sharedCalId', ''))
        || isPlatformAdmin()
      );
    }

    // ── Bug Reports ──────────────────────────────────────────────────────────
    match /bugReports/{reportId} {
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid;
      allow read, update, delete: if isPlatformAdmin();
    }

    // ── Default Deny ─────────────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
